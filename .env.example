# ============================================================
# PREDICTIVE MAINTENANCE PLATFORM - ENVIRONMENT TEMPLATE
# ============================================================

# Backend Server Configuration
PORT=5000
AUTH_SECRET=your-secret-jwt-key-change-in-production

# Machine Metadata
MACHINE_ID=MACH-01
MACHINE_NAME=Machine 01
LOCATION=Shop Floor Bay 4, Facility A

# ThingSpeak IoT Channel Configuration
THING_SPEAK_CHANNEL_ID=
THING_SPEAK_READ_API_KEY=
THING_SPEAK_WRITE_API_KEY=
LIVE_POLL_INTERVAL=15

# Multi-Recipient Email Alert Configuration (Comma-Separated)
ALERT_RECIPIENTS=admin@example.com,customer@example.com,maintenance@example.com
ALERT_RECIPIENT_EMAIL=admin@example.com
ADMIN_EMAIL=admin@example.com
CUSTOMER_EMAIL=customer@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@predictive-maintenance.io
