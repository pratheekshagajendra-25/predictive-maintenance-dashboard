# Environment & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# SQLite Databases & Shm/Wal Files
*.db
*.db-journal
*.db-wal
*.db-shm
backend/*.db
backend/*.db-wal
backend/*.db-shm

# Node Dependencies & Logs
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads & Runtime Temp Files
backend/uploads/*
!backend/uploads/.gitkeep
uploads/
test_*.csv
test_*.xlsx
backend/sync_email_config.js
backend/check_users.js
backend/clean_zero_state.js
backend/reset_user_passwords.js

# Python Bytecode & Cache
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Build Output
frontend/dist/
frontend/dist-ssr/
*.local

# OS & Editor Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
